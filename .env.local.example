# Database
DATABASE_URL=postgresql://user:password@localhost:5432/firelife

# NextAuth
NEXTAUTH_SECRET=your-secret-key-here
NEXTAUTH_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# お支払い・解約ポータル（任意）。設定すると「お支払い・解約」ボタンがこのURLを別タブで開く。
# 未設定なら Stripe カスタマーポータル(/api/stripe/portal)にフォールバック。
# 例: LaunchPass のメンバーポータル等
NEXT_PUBLIC_BILLING_PORTAL_URL=

# Community Beta (set to "true" to allow free access without subscription)
COMMUNITY_BETA_FREE=true
NEXT_PUBLIC_COMMUNITY_BETA_FREE=true

# Google Sheets (Q&A sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id
