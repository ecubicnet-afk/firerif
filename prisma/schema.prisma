generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  hashedPassword String
  name           String?
  role           Role     @default(MEMBER)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  subscription  Subscription?
  questions     Question[]
  budgetEntries    BudgetEntry[]
  budgetPlans      BudgetPlan[]
  budgetTemplates  BudgetTemplate[]
  assets             Asset[]
  portfolioHoldings  PortfolioHolding[]
  assetSnapshots     AssetSnapshot[]
  visionItems        VisionItem[]
  todos              Todo[]
  lifePlans          LifePlan[]
  submissions        AssignmentSubmission[]
  journalEntries     JournalEntry[]
}

enum Role {
  MEMBER
  ADMIN
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(INACTIVE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INACTIVE
  TRIALING
}

model VideoCourse {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  description  String?
  thumbnailUrl String?
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())

  episodes Episode[]
}

model Episode {
  id           String   @id @default(cuid())
  courseId      String
  title        String
  description  String?
  body         String?  // 動画ページ直下の補足・FAQ・リンク（Markdown）
  videoUrl     String
  thumbnailUrl String?
  duration     Int?
  sortOrder    Int      @default(0)
  isFree       Boolean  @default(false)
  createdAt    DateTime @default(now())

  course VideoCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model LiveStream {
  id          String   @id @default(cuid())
  title       String
  description String?
  embedUrl    String?
  scheduledAt DateTime
  isLive      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Question {
  id             String         @id @default(cuid())
  userId         String
  content        String
  status         QuestionStatus @default(PENDING)
  answerVideoUrl String?
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum QuestionStatus {
  PENDING
  SYNCED
  ANSWERED
}

model BudgetEntry {
  id        String        @id @default(cuid())
  userId    String
  year      Int
  month     Int
  day       Int           @default(1)
  category  String
  amount    Int
  type      BudgetType
  costType  CostType?     // 固定費 / 変動費（6枠分類）
  payMethod PayMethod?    // クレカ / 口座引落 / 現金（6枠分類）
  memo      String?
  imageData String?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, year, month])
}

enum CostType {
  FIXED
  VARIABLE
}

enum PayMethod {
  CARD
  BANK
  CASH
}

model BudgetPlan {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  month     Int
  category  String
  amount    Int
  type      BudgetType
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, year, month, category, type])
  @@index([userId, year, month])
}

enum BudgetType {
  INCOME
  EXPENSE
  SAVING
}

model BudgetTemplate {
  id        String     @id @default(cuid())
  userId    String
  category  String
  amount    Int
  type      BudgetType
  day       Int        @default(1)
  memo      String?
  endDate   DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, category, type])
}

model Asset {
  id        String        @id @default(cuid())
  userId    String
  name      String
  category  AssetCategory
  amount    Int
  date      DateTime
  memo      String?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

enum AssetCategory {
  CASH
  STOCK
  BOND
  REAL_ESTATE
  CRYPTO
  PENSION
  OTHER
}

model PortfolioHolding {
  id          String   @id @default(cuid())
  userId      String
  source      String   // CSV file name
  name        String   // 銘柄名
  marketValue Int      // 評価額
  profit      Int      // 損益
  nisaType    String   // "特定/一般", "NISA成長", "NISAつみたて" etc.
  assetType   String   // "投資信託", "株式", "ETF", "REIT", "債券"
  region      String   // "日本", "米国", "全世界" etc.
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model AssetSnapshot {
  id             String   @id @default(cuid())
  userId         String
  date           String   // "YYYY-MM-DD"
  totalAsset     Int
  totalProfit    Int
  nisaValue      Int
  cashValue      Int
  purchaseAmount Int
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

model VisionItem {
  id           String    @id @default(cuid())
  userId       String
  title        String
  description  String?
  imageUrl     String?
  targetDate   DateTime?
  targetAmount Int?
  sortOrder    Int       @default(0)
  createdAt    DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Todo {
  id        String    @id @default(cuid())
  userId    String
  title     String
  completed Boolean   @default(false)
  dueDate   DateTime?
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LifePlan {
  id        String   @id @default(cuid())
  userId    String
  name      String   @default("マイプラン")
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Assignment {
  id          String                 @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime?
  sortOrder   Int                    @default(0)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String           @id @default(cuid())
  assignmentId String
  userId       String
  content      String
  status       SubmissionStatus @default(SUBMITTED)
  feedback     String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  assignment Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, userId])
  @@index([userId])
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
  COMPLETED
}

model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  date      String
  content   String
  amount    Int?
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}
